
@book{biagioli_gaming_2020,
	title = {Gaming the Metrics: Misconduct and Manipulation in Academic Research},
	isbn = {978-0-262-35657-2},
	shorttitle = {Gaming the Metrics},
	abstract = {How the increasing reliance on metrics to evaluate scholarly publications has produced new forms of academic fraud and misconduct.The traditional academic imperative to “publish or perish” is increasingly coupled with the newer necessity of “impact or perish”—the requirement that a publication have “impact,” as measured by a variety of metrics, including citations, views, and downloads. Gaming the Metrics examines how the increasing reliance on metrics to evaluate scholarly publications has produced radically new forms of academic fraud and misconduct. The contributors show that the metrics-based “audit culture” has changed the ecology of research, fostering the gaming and manipulation of quantitative indicators, which lead to the invention of such novel forms of misconduct as citation rings and variously rigged peer reviews. The chapters, written by both scholars and those in the trenches of academic publication, provide a map of academic fraud and misconduct today. They consider such topics as the shortcomings of metrics, the gaming of impact factors, the emergence of so-called predatory journals, the “salami slicing” of scientific findings, the rigging of global university rankings, and the creation of new watchdogs and forensic practices.},
	pagetotal = {307},
	publisher = {{MIT} Press},
	author = {Biagioli, Mario and Lippman, Alexandra},
	date = {2020-01-28},
	langid = {english},
	note = {Google-Books-{ID}: 6OfIDwAAQBAJ},
	keywords = {Education / Evaluation \& Assessment, Education / Schools / Levels / Higher, Language Arts \& Disciplines / Library \& Information Science / General},
}

